<mujoco model="peg_in_hole_lite">
  <!--
    RLDC-lite peg-in-hole: 단순화된 4-DoF 팔 (slide x/y/z + wrist hinge) 이 강체로
    고정된 사각 peg를 4벽 소켓(hole)에 삽입하는 태스크.

    좌표계 메모 (env가 그대로 가정하는 값들, 모델을 고치면 env도 같이 확인할 것):
      - hole_socket 바디는 조인트가 없는 고정 바디. 도메인 무작위화 시 Python에서
        model.body_pos[hole_id]를 직접 덮어쓰고 mj_forward로 재계산한다.
      - hole 개구부(opening) 평면은 hole_socket 로컬 z=0, 바닥은 z=-0.04.
      - peg는 wrist 바디의 자식이며 그 자체는 조인트가 없다(그리퍼에 강체로 고정된
        것으로 취급). 따라서 peg_tip_site에 대한 force/torque 센서는 peg-wrist 간
        구속력, 즉 접촉으로 인한 실제 반력을 그대로 읽는다.
      - hole opening half-width = 0.0115m, peg half-width = 0.010m
        => 편측 clearance 1.5mm, 총 지름 clearance 3mm (임시값, README 참고).
  -->
  <compiler angle="radian" inertiafromgeom="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10" gravity="0 0 -9.81"/>
  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
  </visual>

  <default>
    <default class="arm_link">
      <geom type="box" contype="0" conaffinity="0" rgba="0.6 0.6 0.65 1"/>
      <joint damping="5" armature="0.01"/>
    </default>
    <default class="wrist_joint">
      <joint damping="0.5" armature="0.002"/>
    </default>
    <default class="contact">
      <geom contype="1" conaffinity="1" condim="4" friction="0.5 0.01 0.001" solref="0.002 1" solimp="0.9 0.95 0.001"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <light pos="0.3 -0.3 0.4" dir="-0.6 0.6 -0.8" diffuse="0.4 0.4 0.4"/>

    <!-- 시각적 참조용 바닥 (충돌 없음, 순수 렌더링 배경) -->
    <geom name="ground" type="plane" pos="0 0 -0.15" size="0.3 0.3 0.01" contype="0" conaffinity="0" rgba="0.5 0.5 0.52 1"/>

    <!-- Hole: 조인트 없는 고정 소켓. 4개 벽 세그먼트(picture-frame) + 바닥. -->
    <body name="hole_socket" pos="0 0 0">
      <geom class="contact" name="hole_wall_px" type="box" pos="0.0155 0 -0.02" size="0.004 0.0195 0.02" rgba="0.55 0.55 0.6 1"/>
      <geom class="contact" name="hole_wall_nx" type="box" pos="-0.0155 0 -0.02" size="0.004 0.0195 0.02" rgba="0.55 0.55 0.6 1"/>
      <geom class="contact" name="hole_wall_py" type="box" pos="0 0.0155 -0.02" size="0.0195 0.004 0.02" rgba="0.55 0.55 0.6 1"/>
      <geom class="contact" name="hole_wall_ny" type="box" pos="0 -0.0155 -0.02" size="0.0195 0.004 0.02" rgba="0.55 0.55 0.6 1"/>
      <geom class="contact" name="hole_floor" type="box" pos="0 0 -0.042" size="0.0115 0.0115 0.002" rgba="0.55 0.55 0.6 1"/>
      <site name="hole_center_site" pos="0 0 0" size="0.002" rgba="1 0 0 0.5"/>
    </body>

    <!-- 단순화된 4-DoF 팔: 직교 슬라이드 x,y,z + wrist hinge.
         각 캐리지 바디에는 실제 조인트 이동 범위를 덮는 얇은 "레일" 시각 geom을
         추가로 붙여서(질량은 무시할 만큼 작게 줘서 물리에는 영향 없음), 팔이
         서로 연결되지 않은 채 허공에 뜬 조각들처럼 보이지 않고 갠트리(gantry)형
         구조로 보이게 한다. -->
    <body name="arm_base" pos="0 0 0.15">
      <geom class="arm_link" size="0.015 0.015 0.005" rgba="0.2 0.2 0.2 1"/>
      <geom class="arm_link" name="rail_x" type="box" pos="0 0 0" size="0.037 0.006 0.006" rgba="0.35 0.35 0.4 1" mass="0.001"/>
      <body name="carriage_x" pos="0 0 0" gravcomp="1">
        <joint name="slide_x" type="slide" axis="1 0 0" range="-0.03 0.03"/>
        <geom class="arm_link" size="0.014 0.014 0.014" mass="0.2" rgba="0.75 0.25 0.25 1"/>
        <geom class="arm_link" name="rail_y" type="box" pos="0 0 0" size="0.006 0.037 0.006" rgba="0.35 0.35 0.4 1" mass="0.001"/>
        <body name="carriage_y" pos="0 0 0" gravcomp="1">
          <joint name="slide_y" type="slide" axis="0 1 0" range="-0.03 0.03"/>
          <geom class="arm_link" size="0.013 0.013 0.013" mass="0.2" rgba="0.25 0.6 0.3 1"/>
          <geom class="arm_link" name="rail_z" type="box" pos="0 0 -0.055" size="0.006 0.006 0.078" rgba="0.35 0.35 0.4 1" mass="0.001"/>
          <body name="carriage_z" pos="0 0 0" gravcomp="1">
            <joint name="slide_z" type="slide" axis="0 0 1" range="-0.13 0.02"/>
            <geom class="arm_link" size="0.012 0.012 0.012" mass="0.2" rgba="0.25 0.4 0.75 1"/>
            <body name="wrist" pos="0 0 0" gravcomp="1">
              <joint name="hinge_wrist" class="wrist_joint" type="hinge" axis="0 0 1" range="-0.7 0.7"/>
              <geom class="arm_link" size="0.009 0.009 0.015" mass="0.1" rgba="0.55 0.35 0.75 1"/>
              <!-- peg: wrist 자식이지만 자체 조인트가 없음 -> 그리퍼에 강체로 고정된 것으로 취급 -->
              <body name="peg" pos="0 0 -0.03" gravcomp="1">
                <geom class="contact" name="peg_geom" type="box" size="0.010 0.010 0.03" mass="0.05" rgba="0.95 0.35 0.05 1"/>
                <site name="peg_tip_site" pos="0 0 -0.03" size="0.003" rgba="0 1 0 1"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="act_x" joint="slide_x" kp="800" ctrlrange="-0.03 0.03"/>
    <position name="act_y" joint="slide_y" kp="800" ctrlrange="-0.03 0.03"/>
    <position name="act_z" joint="slide_z" kp="1000" ctrlrange="-0.13 0.02"/>
    <position name="act_wrist" joint="hinge_wrist" kp="30" ctrlrange="-0.7 0.7"/>
  </actuator>

  <sensor>
    <force name="peg_force" site="peg_tip_site"/>
    <torque name="peg_torque" site="peg_tip_site"/>
  </sensor>
</mujoco>
